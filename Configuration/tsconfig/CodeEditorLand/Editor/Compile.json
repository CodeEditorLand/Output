{
	"compilerOptions": {
		"baseUrl": "../../../../../../Dependency/Microsoft/Dependency/Editor/Source",

		"outDir": "../../../../Target/CodeEditorLand/Editor",

		"rootDir": "../../../../../../Dependency/Microsoft/Dependency/Editor/Source",

		"jsx": "preserve",

		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],

		"useDefineForClassFields": false,

		"noImplicitReturns": true,

		"noImplicitOverride": true,

		"noUnusedLocals": true,

		"allowUnreachableCode": false,

		"strict": true,

		"allowImportingTsExtensions": false,

		"isolatedModules": false,

		"exactOptionalPropertyTypes": false,

		"paths": {
			"@vs/*": [
				"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/vs/*"
			]
		},

		"module": "ESNext",

		"moduleResolution": "Bundler",

		"target": "ESNext",

		"verbatimModuleSyntax": false
	},

	"exclude": ["**/node_modules/**", "**/Target/**"],

	"extends": "./tsconfig.json",

	"include": [
		"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/*.ts",

		"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/typings",

		"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/vs/**/*.ts",

		"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/vscode-dts/vscode.proposed.*.d.ts",

		"../../../../../../Dependency/Microsoft/Dependency/Editor/Source/vscode-dts/vscode.d.ts"
	],

	"watchOptions": {
		"excludeDirectories": ["**/node_modules/**", "**/Target/**"]
	}
}
