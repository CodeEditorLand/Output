{
	"compilerOptions": {
		"baseUrl": "./",
		"outDir": "Target",
		"rootDir": "./Source",
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"composite": true
	},
	"extends": "@playform/build/tsconfig",
	"include": ["Source"],
	"exclude": [
		"Target",
		"node_modules",
		"Source/Plugin/Transform/Replace/Product",
		"Source/Polyfill/Child/Process",
		"Source/Polyfill/File/Protocol",
		"Source/Polyfill/File/System",
		"Source/Polyfill/IPC/Renderer",
		"Source/Polyfill/Native/Module",
		"Source/Polyfill/Shared/Process",
		"Source/Polyfill/Process",
		"Source/Service/Tauri/Main/Process"
	]
}
